# Демо-копия лендинга кровли/пристроек для портфолио
DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8
AddType image/webp .webp

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /portfolio/site/krovlya/

  # pristroyki.php -> pristroyki (как на живом сайте)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+(portfolio/site/krovlya/.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<FilesMatch "\.(md|env|log|ini|bak|sql|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
